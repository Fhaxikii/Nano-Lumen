# Nano 环境变量参考 / Environment variables reference (.env.example)
#
# 普通用户不需要创建或编辑 .env：
#   · API 厂商 / Key / 中转 / 代理 —— 在设置「通用 → 环境配置」里填，
#     保存时界面会自动创建并更新 .env；
# 首次启动若 .env 缺 Key，Nano 会直接弹出配置界面。
#
# Regular users never need to create or edit .env by hand:
#   · API vendor / key / relay / proxy — fill them in Settings →
#     General → Environment; saving writes and updates .env automatically;
# If .env has no key on first launch, Nano opens the config dialog directly.
#
# 本文件只说明 .env 里可能出现哪些键、各自是谁在写、什么时候才需要手动改。
# 所有行都注释着：整份复制为 .env 也不会有任何副作用。
#
# This file only documents which keys may appear in .env, who writes them,
# and when you would ever touch one by hand. Every line is commented out:
# copying the whole file to .env has no effect at all.

# ── 模型接入（设置界面「通用 → 环境配置」自动写入）─────────────────────
# Model access (written automatically by the settings dialog)
#
# NANO_API_VENDOR=anthropic        # anthropic / deepseek
# NANO_API_RELAY_BASE_URL=         # 中转地址；直连时没有这一行
#                                  # relay URL; absent when connecting directly
# NANO_API_RELAY_API_KEY=          # 走中转时的 API Key / API key used via relay
# ANTHROPIC_API_KEY=               # 直连时的 API Key / API key, direct connection
#   （变量名里的 RELAY 沿用自早期版本，为兼容已写好的 .env 而保留）
#   (RELAY in the names is kept from an early version, for compatibility
#    with .env files that are already written)

# ── 网络（设置界面自动写入）───────────────────────────────────────────
# Network (written automatically by the settings dialog)
#
# HTTP_PROXY=
# HTTPS_PROXY=


# ── HuggingFace 镜像（不是 .env 的键，写在这里是因为常被问到）──────────
# HuggingFace mirror (not an .env key; documented here because it often comes up)
#
# install.ps1 会把 HF_ENDPOINT=https://hf-mirror.com 写进 Windows 用户环境变量。
# 海外用户想改回官方源：删除系统环境变量里的那一条即可。
# ⚠️ 不要试图写进 .env 来覆盖它 —— python-dotenv 默认不覆盖已存在的环境变量，
#    写了不生效，只会造成「我明明改了」的错觉。
#
# install.ps1 sets HF_ENDPOINT=https://hf-mirror.com as a Windows user
# environment variable. To go back to the official endpoint, delete that
# entry from your system environment variables.
# ⚠️ Do not try to override it via .env — python-dotenv does not override
#    existing environment variables by default, so the line simply has no
#    effect and only creates the illusion of "but I did change it".
